# Скопируйте этот файл в backend/.env и впишите ключ.
# Ключ DaData (бесплатный тариф) — https://dadata.ru → Личный кабинет → API-ключ.
# Без ключа подсказки адресов идут через Photon (OpenStreetMap) — подходит для разработки.
DADATA_API_KEY=

# Ключ API Яндекс.Расписаний (бесплатно) — https://yandex.ru/dev/rasp/raspapi → Кабинет разработчика.
# С ключом рейс можно выбрать из списка, а время отправления и прибытия подставится по номеру.
YANDEX_RASP_API_KEY=

# Разбор пожеланий из свободного текста («спокойно, без музеев, но с хорошей едой») языковой моделью.
# Без ключей — разбор по ключевым словам.
# YandexGPT (по умолчанию): Yandex Cloud → сервисный аккаунт с ролью ai.languageModels.user → API-ключ;
# YANDEX_FOLDER_ID — идентификатор каталога (b1g…). Модель: yandexgpt/latest (Pro) или yandexgpt-lite/latest.
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=
# Yandex Vision OCR — фото и сканы билетов в форме: сервисный аккаунт с ролью ai.vision.user,
# API-ключ с областью yc.ai.vision.execute. Каталог — YANDEX_FOLDER_ID, если другой — YANDEX_VISION_FOLDER_ID.
YANDEX_VISION_API_KEY=
YANDEX_VISION_FOLDER_ID=
# Claude — https://platform.claude.com → API Keys. Если заданы оба ключа, выбрать Claude: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# Партнёрские ссылки Travelpayouts (Авиасейлс, Туту.ру) — https://www.travelpayouts.com
# TP_MARKER — ваш маркер партнёра, TP_TRS — номер проекта (необязательно).
# Номер программы Авиасейлс по умолчанию 4114; номер Туту.ру возьмите в генераторе ссылок кабинета.
TP_MARKER=
TP_TRS=
TP_PROGRAM_AVIASALES=
TP_PROGRAM_TUTU=
# Островок: номер программы, кампания и erid (рекламная маркировка) — из ссылки, выданной в кабинете
TP_PROGRAM_OSTROVOK=
TP_CAMPAIGN_OSTROVOK=
TP_ERID_OSTROVOK=
# Рекламодатель для пометки «Реклама» у ссылок с erid, например: ООО «…», ИНН …
TP_AD_OSTROVOK=
# Так же для Суточно.ру, Туту.ру, Авиасейлс и Трипстера: TP_PROGRAM_SUTOCHNO, TP_CAMPAIGN_SUTOCHNO, TP_ERID_SUTOCHNO,
# TP_AD_SUTOCHNO, … _TUTU, _AVIASALES, _TRIPSTER
# TP_TOKEN — токен Data API Travelpayouts (кабинет → «API»): цены самолётов в списке рейсов
TP_TOKEN=

# Трипстер, партнёрский API 2.0 — экскурсии к местам программы (кабинет партнёра Трипстера).
# TRIPSTER_PARTNER — идентификатор партнёра, TRIPSTER_SECRET — ключ для получения токена из письма Трипстера.
TRIPSTER_PARTNER=
TRIPSTER_SECRET=

# Почта для писем «забыли пароль» (app/mailer.py).
# Ящик на reg.ru: SMTP_HOST — из панели у ящика (обычно mail.hosting.reg.ru), SMTP_USER — полный адрес,
# SMTP_PASSWORD — пароль ящика. Яндекс 360: smtp.yandex.ru и пароль приложения из Яндекс ID
# (обычный пароль аккаунта SMTP не принимает).
# Порт 465 — SSL сразу, 587 — STARTTLS. SMTP_FROM — адрес в поле «От кого», по умолчанию SMTP_USER.
# Без этих настроек письмо не уходит, а пишется в журнал (journalctl -u tripplan) — удобно при разработке.
# Проверить настройки: cd backend && .venv/bin/python -m app.mailer адрес@почта.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Адрес, по которому пользователь открывает приложение: из него собирается ссылка в письме.
APP_URL=http://localhost:8000
